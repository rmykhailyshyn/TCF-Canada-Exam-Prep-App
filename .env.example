# SQLite (libSQL) database URL used by Drizzle (server + migrations). A local `file:` path — no
# Docker, no database server. Relative paths resolve against the repo root; the parent directory is
# created automatically. Defaults to file:./data/tcf_prep.db when unset.
DATABASE_URL=file:./data/tcf_prep.db

# Backend server port (client dev server proxies /api to this).
PORT=3001

# Canonical on-disk store for all media (listening audio, reading passage images, speaking
# recordings), laid out in section subfolders: listening/, reading/, speaking/. Importers COPY
# source files in here and the DB stores paths RELATIVE to this directory, so the data is
# self-contained and portable. Defaults to <repo-root>/data/media (alongside the SQLite DB) when
# unset; set an absolute path to store media elsewhere.
# MEDIA_DIR=/absolute/path/to/media

# Selectable LLM provider (Milestone 17): every Claude call (Writing/Speaking scoring + correction,
# reading/listening enrichment) goes through one seam (server/lib/llm-provider.ts), selected by
# LLM_PROVIDER — "cli" (default) or "api". Any unset/unrecognised value resolves to "cli".
# LLM_PROVIDER=cli

# cli (default): drives the LOCAL Claude CLI (not the HTTP API). CLAUDE_CLI_BIN is the CLI binary
# (defaults to `claude` on PATH); CLAUDE_CLI_MODEL is an optional model override passed as `--model`
# (e.g. claude-opus-4-8). No API key is needed — the CLI handles its own authentication.
# CLAUDE_CLI_BIN=claude
# CLAUDE_CLI_MODEL=claude-opus-4-8

# api: calls the Claude Messages API directly over HTTPS (no local binary needed) — this is what lets
# a deployed Cloudflare Worker score online when ANTHROPIC_API_KEY is bound as a Worker secret instead
# (see the Cloudflare deployment section below; NOT read from this file on the Worker).
# ANTHROPIC_API_KEY is required when LLM_PROVIDER=api; CLAUDE_API_MODEL is the model to use (e.g.
# claude-opus-4-8) and is also required. CLAUDE_API_BASE_URL and CLAUDE_API_MAX_TOKENS are optional.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_API_MODEL=claude-opus-4-8
# CLAUDE_API_BASE_URL=https://api.anthropic.com
# CLAUDE_API_MAX_TOKENS=4096

# Cloudflare deployment (Milestones 15, 17) — these are NOT read from .env. The Worker reads its
# config from wrangler.toml and its secrets from the Cloudflare Workers secret store / a local
# `.dev.vars` file (for `wrangler dev`). Documented here for discoverability only:
#   ACCESS_SHARED_SECRET  Optional. When set as a Worker secret (`wrangler secret put
#                         ACCESS_SHARED_SECRET`), the Worker requires a matching `X-Access-Secret`
#                         request header — the documented fallback when Cloudflare Access is not used.
#                         Leave unset to rely on Cloudflare Access (the default, zero app code).
#   ANTHROPIC_API_KEY     Optional. When bound as a Worker secret (`wrangler secret put
#                         ANTHROPIC_API_KEY`), the Worker uses the Claude HTTP API to score Writing
#                         submissions online (GET /api/health reports aiScoring: true). Leave unset to
#                         keep the Worker practice-only (unscored), as before Milestone 17.
#   CLAUDE_API_MODEL      Required alongside ANTHROPIC_API_KEY — set as a Worker var in wrangler.toml.
#   CLAUDE_API_BASE_URL, CLAUDE_API_MAX_TOKENS  Optional Worker vars, same meaning as above.
# See CLAUDE.md "Cloudflare deployment" for the full runbook.
