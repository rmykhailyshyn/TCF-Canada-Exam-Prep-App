# SQLite (libSQL) database URL used by Drizzle (server + migrations). A local `file:` path — no
# Docker, no database server. Relative paths resolve against the repo root; the parent directory is
# created automatically. Defaults to file:./data/tcf_prep.db when unset.
DATABASE_URL=file:./data/tcf_prep.db

# Backend server port (client dev server proxies /api to this).
PORT=3001

# Canonical on-disk store for all media (listening audio, reading passage images, speaking
# recordings), laid out in section subfolders: listening/, reading/, speaking/. Importers COPY
# source files in here and the DB stores paths RELATIVE to this directory, so the data is
# self-contained and portable. Defaults to <repo-root>/data/media (alongside the SQLite DB) when
# unset; set an absolute path to store media elsewhere.
# MEDIA_DIR=/absolute/path/to/media

# LLM enrichment (Milestone 7): `npm run enrich` drives the LOCAL Claude CLI (not the HTTP API).
# CLAUDE_CLI_BIN is the CLI binary (defaults to `claude` on PATH); CLAUDE_CLI_MODEL is an optional
# model override passed as `--model` (e.g. claude-opus-4-8). No API key is needed — the CLI handles
# its own authentication.
# CLAUDE_CLI_BIN=claude
# CLAUDE_CLI_MODEL=claude-opus-4-8

# Cloudflare deployment (Milestone 15) — these are NOT read from .env. The Worker reads its config
# from wrangler.toml and its secrets from the Cloudflare Workers secret store / a local `.dev.vars`
# file (for `wrangler dev`). Documented here for discoverability only:
#   ACCESS_SHARED_SECRET  Optional. When set as a Worker secret (`wrangler secret put
#                         ACCESS_SHARED_SECRET`), the Worker requires a matching `X-Access-Secret`
#                         request header — the documented fallback when Cloudflare Access is not used.
#                         Leave unset to rely on Cloudflare Access (the default, zero app code).
# See CLAUDE.md "Cloudflare deployment" for the full runbook.
