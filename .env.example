# PostgreSQL connection string used by Drizzle (server + migrations).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tcf_prep

# Express server port (client dev server proxies /api to this).
PORT=3001

# Directory listening audio basenames resolve against on Question Bank import (Milestone 5).
# Exports carry the MP3 basename only; import joins it onto this directory to form the stored
# file path, warning when the file is absent. Defaults to <repo-root>/media when unset.
# MEDIA_DIR=/absolute/path/to/media
