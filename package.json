{
  "name": "tcf-canada-exam-prep-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client && npm run typecheck:server",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "typecheck:client": "tsc -p client/tsconfig.json --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit && tsc -p server/tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:d1:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy:content": "tsx scripts/deploy-content.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate-media": "tsx scripts/migrate-media-paths.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "seed:listening-dev": "tsx scripts/seed-listening-dev.ts",
    "ocr": "tsx scripts/ocr.ts",
    "transcribe": "tsx scripts/transcribe.ts",
    "enrich": "tsx scripts/enrich.ts",
    "import:writing": "tsx scripts/import-writing.ts",
    "import:speaking": "tsx scripts/import-speaking.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wrangler": "^4.110.0"
  }
}
