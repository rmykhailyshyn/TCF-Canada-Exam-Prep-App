{
  "name": "tcf-canada-exam-prep-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev:server:coverage": "NODE_V8_COVERAGE=coverage/.v8-e2e-server node --import tsx server/index.ts",
    "dev:coverage": "COVERAGE=1 concurrently -n server,client -c blue,green \"NODE_V8_COVERAGE=coverage/.v8-e2e-server node --import tsx server/index.ts\" \"npm run dev:client\"",
    "build": "npm run build -w client && npm run typecheck:server",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "typecheck:client": "tsc -p client/tsconfig.json --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit && tsc -p server/tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "analyze": "eslint -c eslint.analysis.config.js .",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:d1:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy:content": "tsx scripts/deploy-content.ts",
    "test": "vitest run",
    "coverage:unit": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate-media": "tsx scripts/migrate-media-paths.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "seed:listening-dev": "tsx scripts/seed-listening-dev.ts",
    "ocr": "tsx scripts/ocr.ts",
    "transcribe": "tsx scripts/transcribe.ts",
    "enrich": "tsx scripts/enrich.ts",
    "import:writing": "tsx scripts/import-writing.ts",
    "import:speaking": "tsx scripts/import-speaking.ts",
    "test:e2e": "playwright test",
    "coverage:e2e:clean": "node -e \"const fs=require('fs');for(const d of ['coverage/.v8-e2e-server','coverage/e2e-server','coverage/e2e-client'])fs.rmSync(d,{recursive:true,force:true})\"",
    "coverage:e2e:report": "tsx scripts/coverage-e2e-server-report.ts",
    "coverage:e2e": "npm run coverage:e2e:clean && COVERAGE=1 playwright test && npm run coverage:e2e:report",
    "coverage:combine": "tsx scripts/coverage-combine.ts",
    "coverage": "npm run coverage:unit && npm run coverage:e2e && npm run coverage:combine"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-istanbul": "2.1.9",
    "c8": "10.1.3",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.1",
    "drizzle-orm": "^0.38.3",
    "eslint": "^9.17.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-security": "4.0.1",
    "globals": "^17.7.0",
    "nyc": "17.1.0",
    "prettier": "^3.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vite-plugin-istanbul": "7.2.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
